[editor]
line_wrapping=true
line_break_column=70
auto_continue_multiline=true

[file_prefs]
final_new_line=true
ensure_convert_new_lines=true
strip_trailing_spaces=true
replace_tabs=false

[indentation]
indent_width=8
indent_type=1
indent_hard_tab_width=8
detect_indent=false
detect_indent_width=false
indent_mode=2

[project]
name=kdbx_vault
base_path=/home/fatman/Repositories/kdbx_vault
description=
file_patterns=*.go;*.conf;go.mod;go.sum;Tupfile;*.md;

[long line marker]
long_line_behaviour=1
long_line_column=70

